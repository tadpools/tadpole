# Normalize line endings: LF everywhere (working tree included), so
# core.autocrlf never re-flags files. Windows scripts opt back into CRLF.
* text=auto eol=lf

# Source and config always LF
*.gleam text
*.erl text
*.toml text
*.yml text
*.yaml text
*.md text
*.json text

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Shell scripts must stay LF or bash chokes on them
*.sh text eol=lf

# Binary
*.png binary
*.ico binary
*.gif binary
